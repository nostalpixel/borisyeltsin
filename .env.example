# Copy to .env. Compose reads .env for substitution. Do not commit .env.
# Use a password without URL-reserved characters (@ : / # ?), or set DATABASE_URL yourself.

POSTGRES_PASSWORD=change-me
BORISELTSYN_VERSION=dev
HTTP_PORT=8080

PUBLIC_URL=http://localhost:8080
# Session cookies are Secure (HTTPS only). Set false only to try the app over
# plain http://localhost; never on a deployment others reach.
COOKIE_SECURE=true
TRUST_PROXY=false
SESSION_TTL=12h
ALERT_TIMEZONE=UTC

# External Authentik. Leave the issuer empty and the process still starts.
# Login returns 503 until these are set.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_MFA_AMR=mfa,otp,totp,webauthn

# Used only while the database has zero users. The token is printed once.
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_OIDC_ISSUER=
BOOTSTRAP_OIDC_SUBJECT=
BOOTSTRAP_EMAIL=

# Any of the variables above can be supplied as KEY_FILE, a path to a Docker secret.
# When the file is readable it replaces the environment value.
# DATABASE_URL_FILE=/run/secrets/database_url
# OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
